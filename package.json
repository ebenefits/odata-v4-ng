{
  "name": "@ebenefitsbv/odata-v4-ng",
  "version": "22.0.0",
  "license": "MIT",
  "description": "Client side OData V4 typescript library for Angular, continuance on the version originally built by Riccardo Mariani",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ebenefits/odata-v4-ng/odata-v4-ng.git"
  },
  "keywords": [
    "client",
    "odata",
    "odata v4",
    "typescript",
    "angular"
  ],
  "author": "eBenefits B.V.",
  "bugs": {
    "url": "https://github.com/ebenefits/odata-v4-ng/issues"
  },
  "homepage": "https://github.com/ebenefits/odata-v4-ng#readme",
  "scripts": {
    "ng": "ng",
    "start": "ng build odata-v4-ng && ng serve",
    "build": "npm run buildAll",
    "test": "ng test",
    "lint": "ng lint",
    "tag-package-version": "npm version 21.0.0 --allow-same-version --git-tag-version && node scripts/align-package-version-number.js",
    "buildLib": "ncp README.md projects/odata-v4-ng/README.md && ng lint odata-v4-ng && ng test odata-v4-ng && ng build odata-v4-ng --configuration=production",
    "buildApp": "ng lint odata-v4-ng-app && ng test odata-v4-ng-app && ng build odata-v4-ng-app --configuration=production && rimraf docs && ncp dist/odata-v4-ng-app docs && rimraf dist/odata-v4-ng-app",
    "buildAll": "npm run buildLib && npm run buildApp",
    "publish": "npm run tag-package-version && npm run buildLib && cd dist/odata-v4-ng && npm publish --access public && cd ../../"
  },
  "private": false,
  "dependencies": {
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/platform-browser-dynamic": "^22.1.3",
    "@angular/router": "^22.1.3",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "uuid": "^14.0.2",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.5",
    "@angular-eslint/builder": "^22.1.0",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@types/jasmine": "^5.1.15",
    "@types/node": "^22.20.1",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.9.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^5.13.0",
    "jasmine-spec-reporter": "^7.0.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "ncp": "^2.0.0",
    "ng-packagr": "^22.1.1",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "sockjs": {
      "uuid": "^11.1.1"
    }
  }
}
